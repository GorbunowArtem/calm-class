{
  "Aws": {
    "Region": "eu-west-1",
    "UseParamStore": true
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Boden.Serilog.Enrichers.Deployment",
      "Boden.Serilog.Formatting.RenderedJson"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "Formatter": "Boden.Serilog.Formatting.RenderedJson.RenderedJsonFormatter, Boden.Serilog.Formatting.RenderedJson"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "FromDeploymentContext"
    ]
  }
}
